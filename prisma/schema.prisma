// 需要在 .env 中配置 DATABASE_URL，格式：mysql://用户名:密码@localhost:3306/数据库名

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  RUNNER
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PICKED
  DELIVERING
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  PENDING
  SCHEDULED
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ComplaintStatus {
  PENDING
  PROCESSING
  RESOLVED
  REJECTED
}

enum ReportStatus {
  PENDING
  PROCESSED
  REJECTED
}

enum ReportProcessAction {
  WARN
  DEDUCT_SCORE
  FREEZE
}

enum CouponType {
  DISCOUNT
  CASH
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum UserCouponStatus {
  UNUSED
  USED
  EXPIRED
}

enum CouponAction {
  RECEIVE
  USE
  EXPIRE
  ADMIN_GIVE
}

enum CouponTriggerType {
  NEW_USER
  BIRTHDAY
  HOLIDAY
}

enum ForumPostStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum ForumCommentStatus {
  APPROVED
  HIDDEN
}

enum MerchantStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum FoodOrderStatus {
  PENDING_PAYMENT
  PAID
  MERCHANT_ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  ACCEPTED
  PICKED
  DELIVERING
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum MemberLevel {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

model User {
  id            Int       @id @default(autoincrement())
  student_id    String?   @unique
  phone         String?   @unique
  password_hash String?
  nickname      String?
  avatar        String?
  role          Role      @default(USER)
  status        Int       @default(1)
  credit_score  Int       @default(0)
  member_level  MemberLevel @default(BRONZE)
  invite_code   String?   @unique @db.VarChar(16)
  invited_by    Int?
  birth_date    DateTime? @db.Date
  id_card       String?   @db.VarChar(18)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  auth                   UserAuth?
  auth_audits            UserAuth[]            @relation("UserAuthAdmin")
  wallet                 UserWallet?
  tasks                  Task[]                @relation("TaskPublisher")
  orders_taken           Order[]               @relation("OrderTaker")
  chat_messages_sent     ChatMessage[]         @relation("ChatMessageFromUser")
  chat_messages_received ChatMessage[]         @relation("ChatMessageToUser")
  reports                Report[]              @relation("ReportRunner")
  reports_processed      Report[]              @relation("ReportAdmin")
  earnings               Earning[]
  withdraws              Withdraw[]            @relation("WithdrawUser")
  withdraw_audits        Withdraw[]            @relation("WithdrawAuditAdmin")
  refunds_applied        Refund[]              @relation("RefundUser")
  refunds_as_runner      Refund[]              @relation("RefundRunner")
  refund_audits          Refund[]              @relation("RefundAuditAdmin")
  admin_logs             AdminLog[]
  login_logs             LoginLog[]
  complaints_created     Complaint[]           @relation("ComplaintCreator")
  complaints_processed   Complaint[]           @relation("ComplaintAdmin")
  messages               Message[] // 接收的消息
  messages_sent          Message[]             @relation("SenderMessages") // 发送的消息
  unfreeze_applications  UnfreezeApplication[] @relation("userUnfreezeApplications") // 用户提交的解封申请
  unfreeze_processed     UnfreezeApplication[] @relation("adminProcessedUnfreeze") // 管理员处理的申请
  credit_logs            CreditLog[] // 添加这一行 👈
  coupons_created        Coupon[]              @relation("CouponCreator")
  user_coupons           UserCoupon[]
  coupon_logs            CouponLog[]
  coupon_events_created  CouponEvent[]         @relation("CouponEventCreator")
  forum_posts            ForumPost[]           @relation("ForumPostAuthor")
  forum_posts_audited    ForumPost[]           @relation("ForumPostAuditor")
  forum_comments         ForumComment[]        @relation("ForumCommentAuthor")
  forum_comments_audited ForumComment[]        @relation("ForumCommentAuditor")
  forum_post_likes       ForumPostLike[]
  forum_favorites        ForumFavorite[]
  merchants_owned        Merchant[]            @relation("MerchantOwner")
  food_orders            FoodOrder[]           @relation("FoodOrderUser")
  food_orders_taken      FoodOrder[]           @relation("FoodOrderRunner")
  food_order_events      FoodOrderTimeline[]   @relation("FoodOrderEventActor")
  inviter                User?                 @relation("UserInvitations", fields: [invited_by], references: [id], onDelete: SetNull)
  invitees               User[]                @relation("UserInvitations")

  @@map("users")
}

model UserAuth {
  id             Int       @id @default(autoincrement())
  user_id        Int       @unique
  real_name      String
  card_image_url String
  audit_status   String    @default("PENDING")
  student_id     String?
  phone          String?
  id_card        String?
  dormitory      String?
  reason         String?   @db.Text
  admin_id       Int?
  processed_at   DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  admin User? @relation("UserAuthAdmin", fields: [admin_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([audit_status])
  @@index([admin_id])
  @@map("user_auths")
}

model UserWallet {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  frozen     Decimal  @default(0) @db.Decimal(12, 2)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  logs WalletLog[]

  @@index([user_id])
  @@map("user_wallets")
}

model WalletLog {
  id             Int      @id @default(autoincrement())
  wallet_id      Int
  type           String
  amount         Decimal  @db.Decimal(12, 2)
  ref_order_id   Int?
  food_order_id  Int?
  before_balance Decimal  @db.Decimal(12, 2)
  after_balance  Decimal  @db.Decimal(12, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  wallet    UserWallet @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  ref_order Order?     @relation("WalletLogOrder", fields: [ref_order_id], references: [id], onDelete: SetNull)
  food_order FoodOrder? @relation("FoodWalletLog", fields: [food_order_id], references: [id], onDelete: SetNull)

  @@index([wallet_id])
  @@index([ref_order_id])
  @@index([food_order_id])
  @@map("wallet_logs")
}

model Task {
  id               Int        @id @default(autoincrement())
  publisher_id     Int
  pickup_address   String
  pickup_lat       Decimal?   @db.Decimal(10, 6)
  pickup_lng       Decimal?   @db.Decimal(10, 6)
  delivery_address String
  delivery_lat     Decimal?   @db.Decimal(10, 6)
  delivery_lng     Decimal?   @db.Decimal(10, 6)
  type             String
  urgency          Int        @default(0)
  remark           String?    @db.Text
  images_json      Json?
  weight           String?    @db.VarChar(50)
  size             String?    @db.VarChar(100)
  is_fragile       Boolean?   @default(false)
  need_inspection  Boolean?   @default(false)
  is_urgent        Boolean?   @default(false)
  fee_total        Decimal    @default(0) @db.Decimal(12, 2)
  original_amount  Decimal?   @db.Decimal(12, 2)
  discount_amount  Decimal    @default(0) @db.Decimal(12, 2)
  user_coupon_id   String?    @unique
  tip              Decimal    @default(0) @db.Decimal(12, 2)
  status           TaskStatus @default(PENDING)
  scheduled_time   DateTime?
  cancelled_at     DateTime?
  cancel_reason    String?    @db.Text
  created_at       DateTime   @default(now())
  updated_at       DateTime   @default(now()) @updatedAt

  publisher   User        @relation("TaskPublisher", fields: [publisher_id], references: [id], onDelete: Restrict)
  orders      Order[]
  user_coupon UserCoupon? @relation(fields: [user_coupon_id], references: [id], onDelete: SetNull)

  @@index([publisher_id])
  @@map("tasks")
}

model Order {
  id                  Int         @id @default(autoincrement())
  task_id             Int
  taker_id            Int?
  status              OrderStatus @default(PENDING)
  accept_time         DateTime?
  pickup_time         DateTime?
  delivery_start_time DateTime?
  delivery_time       DateTime?
  complete_time       DateTime?
  eta_minutes         Int?
  final_price         Decimal?    @db.Decimal(12, 2)
  created_at          DateTime    @default(now())
  updated_at          DateTime    @default(now()) @updatedAt

  task          Task          @relation(fields: [task_id], references: [id], onDelete: Cascade)
  taker         User?         @relation("OrderTaker", fields: [taker_id], references: [id], onDelete: SetNull)
  track         OrderTrack?
  pricing_log   PricingLog?
  review        OrderReview?
  reports       Report[]
  earnings      Earning[]
  wallet_logs   WalletLog[]   @relation("WalletLogOrder")
  refund        Refund?
  complaint     Complaint?
  chat_messages ChatMessage[]
  user_coupon   UserCoupon?

  @@index([task_id])
  @@index([taker_id])
  @@map("orders")
}

model ChatMessage {
  id           Int      @id @default(autoincrement())
  order_id     Int
  from_user_id Int
  to_user_id   Int
  message      String   @db.Text
  created_at   DateTime @default(now())

  order     Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  from_user User  @relation("ChatMessageFromUser", fields: [from_user_id], references: [id], onDelete: Cascade)
  to_user   User  @relation("ChatMessageToUser", fields: [to_user_id], references: [id], onDelete: Cascade)

  @@index([order_id, created_at])
  @@index([from_user_id])
  @@index([to_user_id])
  @@map("chat_message")
}

model OrderTrack {
  id                   Int      @id @default(autoincrement())
  order_id             Int      @unique
  pickup_photo_url     String?
  delivery_photo_url   String?
  location_points_json Json?
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now()) @updatedAt

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_tracks")
}

model OrderReview {
  id           Int      @id @default(autoincrement())
  order_id     Int      @unique
  rating       Int
  tags_json    Json?
  comment      String?  @db.Text
  images_json  Json?
  is_anonymous Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_reviews")
}

model Earning {
  id         Int       @id @default(autoincrement())
  user_id    Int
  order_id   Int?
  food_order_id Int?
  amount     Decimal   @db.Decimal(12, 2)
  type       String
  status     String
  settled_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt

  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [order_id], references: [id], onDelete: SetNull)
  food_order FoodOrder? @relation("FoodOrderEarning", fields: [food_order_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([order_id])
  @@index([food_order_id])
  @@map("earnings")
}

model Withdraw {
  id             Int       @id @default(autoincrement())
  user_id        Int
  amount         Decimal   @db.Decimal(12, 2)
  payout_account String?   @db.VarChar(191)
  fee            Decimal   @default(0) @db.Decimal(12, 2)
  expected_at    DateTime?
  status         String
  apply_time     DateTime?
  audit_time     DateTime?
  audit_admin_id Int?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt

  user        User  @relation("WithdrawUser", fields: [user_id], references: [id], onDelete: Cascade)
  audit_admin User? @relation("WithdrawAuditAdmin", fields: [audit_admin_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([audit_admin_id])
  @@map("withdraws")
}

model Refund {
  id             Int          @id @default(autoincrement())
  order_id       Int          @unique
  user_id        Int
  runner_id      Int
  amount         Decimal      @db.Decimal(12, 2)
  reason         String       @db.Text
  status         RefundStatus @default(PENDING)
  apply_time     DateTime     @default(now())
  audit_time     DateTime?
  audit_admin_id Int?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @default(now()) @updatedAt

  order       Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user        User  @relation("RefundUser", fields: [user_id], references: [id], onDelete: Cascade)
  runner      User  @relation("RefundRunner", fields: [runner_id], references: [id], onDelete: Restrict)
  audit_admin User? @relation("RefundAuditAdmin", fields: [audit_admin_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([runner_id])
  @@index([status])
  @@index([audit_admin_id])
  @@map("refunds")
}

model Complaint {
  id           Int             @id @default(autoincrement())
  order_id     Int             @unique
  creator_id   Int
  reason       String          @db.Text
  description  String?         @db.Text
  photos_json  Json?
  status       ComplaintStatus @default(PENDING)
  admin_note   String?         @db.Text
  admin_id     Int?
  processed_at DateTime?
  created_at   DateTime        @default(now())
  updated_at   DateTime        @default(now()) @updatedAt

  order   Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  creator User  @relation("ComplaintCreator", fields: [creator_id], references: [id], onDelete: Cascade)
  admin   User? @relation("ComplaintAdmin", fields: [admin_id], references: [id], onDelete: SetNull)

  @@index([creator_id])
  @@index([admin_id])
  @@index([status])
  @@index([created_at])
  @@map("complaints")
}

model SystemConfig {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("system_config")
}

model ForumCategory {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(40)
  name       String   @db.VarChar(40)
  icon       String?  @db.VarChar(16)
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  posts ForumPost[]

  @@index([is_active, sort_order])
  @@map("forum_categories")
}

model ForumPost {
  id            Int             @id @default(autoincrement())
  author_id     Int
  category_id   Int
  title         String          @db.VarChar(100)
  content       String          @db.Text
  images_json   Json?
  location_name String?         @db.VarChar(120)
  latitude      Decimal?        @db.Decimal(10, 6)
  longitude     Decimal?        @db.Decimal(10, 6)
  status        ForumPostStatus @default(PENDING)
  audit_note    String?         @db.VarChar(300)
  audited_by    Int?
  audited_at    DateTime?
  is_pinned     Boolean         @default(false)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @default(now()) @updatedAt

  author     User             @relation("ForumPostAuthor", fields: [author_id], references: [id], onDelete: Cascade)
  category   ForumCategory    @relation(fields: [category_id], references: [id], onDelete: Restrict)
  auditor    User?            @relation("ForumPostAuditor", fields: [audited_by], references: [id], onDelete: SetNull)
  comments   ForumComment[]
  likes      ForumPostLike[]
  favorites  ForumFavorite[]

  @@index([author_id, created_at])
  @@index([category_id, status, created_at])
  @@index([status, is_pinned, created_at])
  @@map("forum_posts")
}

model ForumComment {
  id         Int                @id @default(autoincrement())
  post_id    Int
  author_id  Int
  content    String             @db.Text
  status     ForumCommentStatus @default(APPROVED)
  audited_by Int?
  audited_at DateTime?
  created_at DateTime           @default(now())
  updated_at DateTime           @default(now()) @updatedAt

  post    ForumPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  author  User      @relation("ForumCommentAuthor", fields: [author_id], references: [id], onDelete: Cascade)
  auditor User?     @relation("ForumCommentAuditor", fields: [audited_by], references: [id], onDelete: SetNull)

  @@index([post_id, status, created_at])
  @@index([author_id, created_at])
  @@map("forum_comments")
}

model ForumPostLike {
  id         Int      @id @default(autoincrement())
  post_id    Int
  user_id    Int
  created_at DateTime @default(now())

  post ForumPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@index([user_id, created_at])
  @@map("forum_post_likes")
}

model ForumFavorite {
  id         Int      @id @default(autoincrement())
  post_id    Int
  user_id    Int
  created_at DateTime @default(now())

  post ForumPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@index([user_id, created_at])
  @@map("forum_favorites")
}

model Merchant {
  id              Int            @id @default(autoincrement())
  owner_id        Int
  name            String         @db.VarChar(80)
  description     String?        @db.Text
  logo            String?        @db.VarChar(500)
  address         String         @db.VarChar(160)
  phone           String?        @db.VarChar(30)
  cover_image     String?        @db.VarChar(500)
  announcement    String?        @db.VarChar(500)
  min_order_amount Decimal       @default(0) @db.Decimal(12, 2)
  prepare_minutes Int            @default(15)
  status          MerchantStatus @default(PENDING)
  audit_note      String?        @db.VarChar(300)
  commission_rate Decimal        @default(0.1000) @db.Decimal(5, 4)
  is_open         Boolean        @default(true)
  business_hours  Json?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @default(now()) @updatedAt

  owner      User           @relation("MerchantOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  menu_items MenuItem[]
  categories FoodCategory[]
  food_orders FoodOrder[]

  @@index([owner_id, status])
  @@index([status, is_open, created_at])
  @@map("merchants")
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  merchant_id Int
  category_id Int?
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  image       String?  @db.VarChar(500)
  price       Decimal  @db.Decimal(12, 2)
  original_price Decimal? @db.Decimal(12, 2)
  option_groups Json?
  stock       Int      @default(-1)
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  merchant         Merchant        @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  category         FoodCategory?   @relation(fields: [category_id], references: [id], onDelete: SetNull)
  food_order_items FoodOrderItem[]

  @@index([merchant_id, is_active, sort_order])
  @@index([category_id])
  @@map("menu_items")
}

model FoodCategory {
  id          Int      @id @default(autoincrement())
  merchant_id Int
  name        String   @db.VarChar(60)
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  merchant   Merchant   @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  menu_items MenuItem[]

  @@unique([merchant_id, name])
  @@index([merchant_id, is_active, sort_order])
  @@map("food_categories")
}

model FoodOrder {
  id              Int             @id @default(autoincrement())
  order_no        String?         @unique @db.VarChar(40)
  user_coupon_id  String?         @unique
  user_id         Int
  merchant_id     Int
  runner_id       Int?
  status          FoodOrderStatus @default(PENDING_PAYMENT)
  delivery_address String          @db.VarChar(180)
  delivery_lat    Decimal?        @db.Decimal(10, 6)
  delivery_lng    Decimal?        @db.Decimal(10, 6)
  contact_phone   String?         @db.VarChar(30)
  remark          String?         @db.VarChar(500)
  item_amount     Decimal         @db.Decimal(12, 2)
  delivery_fee    Decimal         @default(0) @db.Decimal(12, 2)
  discount_amount Decimal         @default(0) @db.Decimal(12, 2)
  commission_rate Decimal         @db.Decimal(5, 4)
  commission_amount Decimal       @default(0) @db.Decimal(12, 2)
  total_amount    Decimal         @db.Decimal(12, 2)
  payable_amount  Decimal         @default(0) @db.Decimal(12, 2)
  merchant_income Decimal         @default(0) @db.Decimal(12, 2)
  runner_income   Decimal         @default(0) @db.Decimal(12, 2)
  platform_income Decimal         @default(0) @db.Decimal(12, 2)
  pickup_code     String?         @db.VarChar(12)
  payment_expire_at DateTime?
  payment_at      DateTime?
  accept_time     DateTime?
  pickup_time     DateTime?
  delivery_start_time DateTime?
  delivered_at       DateTime?
  complete_time   DateTime?
  cancelled_at    DateTime?
  cancel_reason   String?         @db.VarChar(300)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @default(now()) @updatedAt

  user     User      @relation("FoodOrderUser", fields: [user_id], references: [id], onDelete: Cascade)
  merchant Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Restrict)
  runner   User?     @relation("FoodOrderRunner", fields: [runner_id], references: [id], onDelete: SetNull)
  items    FoodOrderItem[]
  timelines FoodOrderTimeline[]
  wallet_logs WalletLog[] @relation("FoodWalletLog")
  earnings Earning[] @relation("FoodOrderEarning")
  user_coupon UserCoupon? @relation("FoodOrderCoupon", fields: [user_coupon_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([merchant_id, status, created_at])
  @@index([runner_id, status, created_at])
  @@index([status, created_at])
  @@index([order_no])
  @@map("food_orders")
}

model FoodOrderItem {
  id           Int      @id @default(autoincrement())
  food_order_id Int
  menu_item_id Int?
  item_name    String   @db.VarChar(100)
  unit_price   Decimal  @db.Decimal(12, 2)
  selected_options Json?
  quantity     Int
  created_at   DateTime @default(now())

  food_order FoodOrder @relation(fields: [food_order_id], references: [id], onDelete: Cascade)
  menu_item  MenuItem? @relation(fields: [menu_item_id], references: [id], onDelete: SetNull)

  @@index([food_order_id])
  @@index([menu_item_id])
  @@map("food_order_items")
}

model FoodOrderTimeline {
  id            Int      @id @default(autoincrement())
  food_order_id Int
  from_status   FoodOrderStatus?
  to_status     FoodOrderStatus
  actor_id      Int?
  actor_role    String?  @db.VarChar(24)
  note          String?  @db.VarChar(300)
  created_at    DateTime @default(now())

  food_order FoodOrder @relation(fields: [food_order_id], references: [id], onDelete: Cascade)
  actor      User?      @relation("FoodOrderEventActor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([food_order_id, created_at])
  @@index([actor_id])
  @@map("food_order_timelines")
}

model AdminLog {
  id          Int      @id @default(autoincrement())
  admin_id    Int
  action      String
  target_type String
  target_id   Int?
  detail_json Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  admin User @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id])
  @@index([target_type, target_id])
  @@map("admin_logs")
}

model LoginLog {
  id         Int      @id @default(autoincrement())
  user_id    Int
  login_time DateTime @default(now())
  ip         String   @db.VarChar(45)
  user_agent String   @db.Text
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([login_time])
  @@index([ip])
  @@map("login_log")
}

model Report {
  id             Int                  @id @default(autoincrement())
  order_id       Int
  runner_id      Int
  type           String               @db.VarChar(50)
  description    String               @db.Text
  photos_json    Json?
  status         ReportStatus         @default(PENDING)
  process_result String?              @db.Text
  process_action ReportProcessAction?
  processed_at   DateTime?
  processed_by   Int?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @default(now()) @updatedAt

  order  Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  runner User  @relation("ReportRunner", fields: [runner_id], references: [id], onDelete: Cascade)
  admin  User? @relation("ReportAdmin", fields: [processed_by], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([runner_id])
  @@index([status])
  @@index([processed_by])
  @@index([processed_at])
  @@index([created_at])
  @@map("reports")
}

model ErrorLog {
  id            Int      @id @default(autoincrement())
  error_message String   @db.Text
  stack         String?  @db.Text
  url           String   @db.Text
  method        String   @db.VarChar(16)
  ip            String   @db.VarChar(45)
  user_id       Int?
  created_at    DateTime @default(now())

  @@index([user_id])
  @@index([created_at])
  @@map("error_log")
}

model Message {
  id              Int      @id @default(autoincrement())
  user_id         Int // 接收者ID
  sender_id       Int? // 发送者ID
  sender_name     String?  @db.VarChar(128) // 发送者名称
  sender_avatar   String?  @db.VarChar(512) // 发送者头像
  conversation_id String?  @db.VarChar(64) // 会话ID，用于跳转
  type            String // chat / system / order
  title           String
  content         String   @db.Text
  related_id      Int? // 订单ID/任务ID
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())

  user   User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sender User? @relation("SenderMessages", fields: [sender_id], references: [id], onDelete: SetNull)

  @@index([user_id, is_read])
  @@index([sender_id])
  @@index([conversation_id])
  @@index([related_id])
  @@map("messages")
}

model UnfreezeApplication {
  id           Int       @id @default(autoincrement())
  user_id      Int
  reason       String    @db.Text
  contact      String?   @db.VarChar(100)
  status       String    @default("PENDING")
  admin_note   String?   @db.Text
  admin_id     Int?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt
  processed_at DateTime?

  user  User  @relation("userUnfreezeApplications", fields: [user_id], references: [id], onDelete: Cascade)
  admin User? @relation("adminProcessedUnfreeze", fields: [admin_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@map("unfreeze_applications")
}

model CreditLog {
  id         Int      @id @default(autoincrement())
  user_id    Int
  delta      Int
  reason     String
  order_id   Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("credit_logs")
}

model PricingLog {
  id                     Int      @id @default(autoincrement())
  order_id               Int      @unique
  task_id                Int?
  distance_km            Decimal? @db.Decimal(10, 3)
  time_slot              String   @db.VarChar(32)
  weather                String?  @db.VarChar(32)
  urgency                Int      @default(0)
  deal_price             Decimal? @db.Decimal(12, 2)
  accept_latency_seconds Int?
  ai_enabled             Boolean  @default(false)
  pricing_model_version  Int?
  created_at             DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([time_slot])
  @@index([weather])
  @@map("pricing_log")
}

model PricingRecommendation {
  id                  Int      @id @default(autoincrement())
  model_version       Int      @unique
  base_fee            Decimal  @db.Decimal(12, 2)
  distance_unit_price Decimal  @db.Decimal(12, 4)
  time_coeff_json     Json?
  weather_coeff_json  Json?
  sample_size         Int      @default(0)
  created_at          DateTime @default(now())

  @@index([created_at])
  @@map("pricing_recommendations")
}

model Coupon {
  id               String       @id @default(uuid())
  name             String       @db.VarChar(191)
  code             String       @unique @db.VarChar(64)
  type             CouponType
  value            Decimal      @db.Decimal(12, 2)
  min_order_amount Decimal      @default(0) @db.Decimal(12, 2)
  max_discount     Decimal      @default(0) @db.Decimal(12, 2)
  usage_limit      Int          @default(1)
  total_limit      Int          @default(0)
  received_count   Int          @default(0)
  used_count       Int          @default(0)
  start_date       DateTime
  end_date         DateTime
  status           CouponStatus @default(ACTIVE)
  created_by       Int
  created_at       DateTime     @default(now())
  updated_at       DateTime     @default(now()) @updatedAt
  discount_type    String?      @db.VarChar(32)
  discount_value   Decimal?     @db.Decimal(12, 2)
  min_amount       Decimal?     @db.Decimal(12, 2)
  validity_days    Int          @default(30)

  creator      User          @relation("CouponCreator", fields: [created_by], references: [id], onDelete: Restrict)
  user_coupons UserCoupon[]
  logs         CouponLog[]
  events       CouponEvent[]

  @@index([status, start_date, end_date])
  @@index([created_by])
  @@map("coupons")
}

model UserCoupon {
  id               String           @id @default(uuid())
  user_id          Int
  coupon_id        String
  order_id         Int?             @unique
  status           UserCouponStatus @default(UNUSED)
  received_at      DateTime         @default(now())
  used_at          DateTime?
  expired_at       DateTime
  created_at       DateTime         @default(now())
  used_order_id    Int?
  claimed_at       DateTime?
  source_event_id  String?
  distribution_key String?          @unique @db.VarChar(191)

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [order_id], references: [id], onDelete: SetNull)
  task   Task?
  food_order FoodOrder? @relation("FoodOrderCoupon")

  @@index([user_id, status, expired_at])
  @@index([coupon_id, status])
  @@index([user_id, claimed_at])
  @@map("user_coupons")
}

model CouponEvent {
  id           String            @id @default(uuid())
  coupon_id    String
  trigger_type CouponTriggerType
  start_date   DateTime?
  end_date     DateTime?
  is_active    Boolean           @default(true)
  created_by   Int
  created_at   DateTime          @default(now())
  updated_at   DateTime          @default(now()) @updatedAt

  coupon  Coupon @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  creator User   @relation("CouponEventCreator", fields: [created_by], references: [id], onDelete: Restrict)

  @@index([trigger_type, is_active, start_date, end_date])
  @@index([coupon_id])
  @@map("coupon_events")
}

model CouponLog {
  id         String       @id @default(uuid())
  user_id    Int
  coupon_id  String
  action     CouponAction
  detail     Json?
  created_at DateTime     @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [coupon_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([coupon_id, action])
  @@map("coupon_logs")
}
